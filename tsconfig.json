{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": { "@shared/*": ["./packages/desktop-contract/src/*"] }
  },
  "include": ["apps/desktop/src", "packages", "electron.vite.config.ts", "vitest.config.ts"],
  "exclude": ["sources", "node_modules", "out"]
}
